#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Fake `docker` for the test suites.
#
# Put tests/fakes first on PATH to simulate a host where Docker is installed but
# unusable (daemon down, or the user is not allowed to use it):
#   - every call is appended to "$FAKE_LOG_DIR/calls.log" as one line:
#       docker <args, shell-quoted>
#   - `docker info` fails with the message the real CLI prints when it cannot
#     reach the daemon;
#   - every other subcommand fails too, so nothing ever reaches the real Docker.
#
# FAKE_LOG_DIR defaults to <repo>/.test/fakes. Nothing is written anywhere else.
set -u

self=$(readlink -f -- "${BASH_SOURCE[0]}")
repo=$(cd -- "$(dirname -- "$self")/../.." && pwd)
log_dir=${FAKE_LOG_DIR:-$repo/.test/fakes}
mkdir -p -- "$log_dir"
{
  printf 'docker'
  (($#)) && printf ' %q' "$@"
  printf '\n'
} >>"$log_dir/calls.log"

case ${1:-} in
  info)
    echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?" >&2
    ;;
  *)
    echo "fake docker (tests/fakes/docker): refusing 'docker $*'" >&2
    ;;
esac
exit 1
